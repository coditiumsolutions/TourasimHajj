@model TourismHajj.Models.Entities.HajjSeason
@{ ViewData["Title"] = "Hajj Seasons Details"; }
<div class="page-header"><h2>Hajj Seasons Details</h2><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.HajjSeasonId">Edit</a></div>
<div class="card-panel"><div class="card-panel-body"><dl class="row mb-0"><dt class="col-sm-3">Season</dt><dd class="col-sm-9">@Model.SeasonName</dd><dt class="col-sm-3">Year</dt><dd class="col-sm-9">@Model.HajjYear</dd><dt class="col-sm-3">Reg Start</dt><dd class="col-sm-9">@Model.RegistrationStartDate</dd><dt class="col-sm-3">Reg End</dt><dd class="col-sm-9">@Model.RegistrationEndDate</dd><dt class="col-sm-3">Dep Start</dt><dd class="col-sm-9">@Model.DepartureStartDate</dd><dt class="col-sm-3">Dep End</dt><dd class="col-sm-9">@Model.DepartureEndDate</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd><dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.IsActive</dd></dl></div></div>
