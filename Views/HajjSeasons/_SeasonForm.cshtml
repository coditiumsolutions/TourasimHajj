@model HajjSeasonInputModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="SeasonName" class="form-label"></label><input asp-for="SeasonName" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="HajjYear" class="form-label"></label><input asp-for="HajjYear" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="RegistrationStartDate" class="form-label"></label><input asp-for="RegistrationStartDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="RegistrationEndDate" class="form-label"></label><input asp-for="RegistrationEndDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="DepartureStartDate" class="form-label"></label><input asp-for="DepartureStartDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="DepartureEndDate" class="form-label"></label><input asp-for="DepartureEndDate" type="date" class="form-control" /></div>
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
</div>