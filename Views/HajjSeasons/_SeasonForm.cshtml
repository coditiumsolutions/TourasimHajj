@model HajjSeasonInputModel
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="@(Model.HajjSeasonId > 0 ? "Edit" : "Create")" method="post" class="form-4col">
            <input type="hidden" asp-for="HajjSeasonId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="SeasonName">Season Name</label>
                <div class="form-4col-field">
                    <input asp-for="SeasonName" class="form-control" />
                    <span asp-validation-for="SeasonName" class="text-danger"></span>
                </div>
                <label class="form-4col-label" asp-for="HajjYear">Hajj Year</label>
                <div class="form-4col-field">
                    <input asp-for="HajjYear" class="form-control" />
                    <span asp-validation-for="HajjYear" class="text-danger"></span>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="RegistrationStartDate">Registration Start</label>
                <div class="form-4col-field">
                    <input asp-for="RegistrationStartDate" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="RegistrationEndDate">Registration End</label>
                <div class="form-4col-field">
                    <input asp-for="RegistrationEndDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="DepartureStartDate">Departure Start</label>
                <div class="form-4col-field">
                    <input asp-for="DepartureStartDate" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="DepartureEndDate">Departure End</label>
                <div class="form-4col-field">
                    <input asp-for="DepartureEndDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="Notes">Notes</label>
                <div class="form-4col-field">
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
                <label class="form-4col-label" asp-for="IsActive">Active</label>
                <div class="form-4col-field form-4col-check">
                    <input asp-for="IsActive" class="form-check-input" />
                </div>
            </div>

            <div class="form-4col-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>