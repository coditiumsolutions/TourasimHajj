@model TourismHajj.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h2>Operations Dashboard</h2>
        <p class="subtitle">Live summary from TravelManagementDB · @DateTime.Now.ToString("dddd, dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <a class="btn btn-accent" asp-controller="Bookings" asp-action="Create"><i class="fa-solid fa-plus me-1"></i> New Booking</a>
        <a class="btn btn-navy" asp-controller="Customers" asp-action="Create"><i class="fa-solid fa-user-plus me-1"></i> New Customer</a>
    </div>
</div>

<div class="row g-3 mb-1">
@{
    var cards = new (string Label, string Value, string Icon, string Tone)[]
    {
        ("Total Customers", Model.TotalCustomers.ToString("N0"), "fa-users", ""),
        ("Total Travelers", Model.TotalTravelers.ToString("N0"), "fa-user", ""),
        ("Total Bookings", Model.TotalBookings.ToString("N0"), "fa-bookmark", "navy"),
        ("Today's Bookings", Model.TodaysBookings.ToString("N0"), "fa-calendar-day", "accent"),
        ("Tourism Packages", Model.TotalTourismPackages.ToString("N0"), "fa-suitcase", ""),
        ("Hajj Pilgrims", Model.TotalHajjPilgrims.ToString("N0"), "fa-kaaba", "navy"),
        ("Umrah Pilgrims", Model.TotalUmrahPilgrims.ToString("N0"), "fa-mosque", ""),
        ("Total Revenue", Model.TotalRevenue.ToString("N2"), "fa-coins", "accent"),
        ("Outstanding", Model.OutstandingPayments.ToString("N2"), "fa-scale-unbalanced", ""),
        ("Total Expenses", Model.TotalExpenses.ToString("N2"), "fa-wallet", "navy")
    };
}
@foreach (var card in cards)
{
    <div class="col-6 col-md-4 col-xl-3 col-xxl-2">
        <partial name="_StatCard" model="card" />
    </div>
}
</div>

<div class="row g-3 mt-1 mb-1">
    <div class="col-xl-8">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5>Monthly Booking Statistics</h5>
            </div>
            <div class="card-panel-body">
                <div class="chart-wrap"><canvas id="chartBookings"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5>Package-wise Sales</h5>
            </div>
            <div class="card-panel-body">
                <div class="chart-wrap"><canvas id="chartPackages"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5>Monthly Revenue</h5>
            </div>
            <div class="card-panel-body">
                <div class="chart-wrap"><canvas id="chartRevenue"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5>Tourism vs Hajj vs Umrah</h5>
            </div>
            <div class="card-panel-body">
                <div class="chart-wrap"><canvas id="chartTypes"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <partial name="_RecentBookings" model="Model.RecentBookings" />
    </div>
    <div class="col-xl-5">
        <partial name="_UpcomingDepartures" model="Model.UpcomingDepartures" />
    </div>
    <div class="col-xl-4">
        <partial name="_PendingVisas" model="Model.PendingVisas" />
    </div>
    <div class="col-xl-4">
        <partial name="_PassportAlerts" model="Model.PassportAlerts" />
    </div>
    <div class="col-xl-4">
        <partial name="_RecentCustomers" model="Model.RecentCustomers" />
    </div>
</div>

@section Scripts {
<script>
(() => {
  const bookings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookings));
  const revenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));
  const packages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageWiseSales));
  const types = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingTypeSplit));

  const labels = d => d.map(x => x.Label ?? x.label);
  const values = d => d.map(x => x.Value ?? x.value);
  const navy = '#0b1f3a';
  const sky = '#2f80c4';
  const gold = '#d4a017';

  const commonOpts = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: { y: { beginAtZero: true, grid: { color: '#edf2f7' } }, x: { grid: { display: false } } }
  };

  new Chart(document.getElementById('chartBookings'), {
    type: 'bar',
    data: {
      labels: labels(bookings),
      datasets: [{
        data: values(bookings),
        backgroundColor: sky,
        borderRadius: 8,
        maxBarThickness: 28
      }]
    },
    options: commonOpts
  });

  new Chart(document.getElementById('chartRevenue'), {
    type: 'line',
    data: {
      labels: labels(revenue),
      datasets: [{
        data: values(revenue),
        borderColor: navy,
        backgroundColor: 'rgba(11,31,58,.08)',
        fill: true,
        tension: .35,
        pointRadius: 3,
        pointBackgroundColor: gold
      }]
    },
    options: commonOpts
  });

  new Chart(document.getElementById('chartPackages'), {
    type: 'doughnut',
    data: {
      labels: labels(packages),
      datasets: [{
        data: values(packages),
        backgroundColor: [navy, sky, gold, '#6b7a8c', '#1f8a5b', '#9b6b9e']
      }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
  });

  new Chart(document.getElementById('chartTypes'), {
    type: 'pie',
    data: {
      labels: labels(types),
      datasets: [{
        data: values(types),
        backgroundColor: [navy, gold, sky]
      }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
  });
})();
</script>
}
