@model IEnumerable<TourismHajj.ViewModels.PendingVisaItem>
<div class="card-panel">
    <div class="card-panel-header">
        <h5><i class="fa-solid fa-passport me-2 text-primary"></i>Pending Visa Applications</h5>
        <a class="btn btn-sm btn-outline-primary" asp-controller="VisaApplications" asp-action="Index">Open</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Traveler</th>
                    <th>Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="VisaApplications" asp-action="Details" asp-route-id="@x.VisaApplicationId">@x.TravelerName</a>
                    </td>
                    <td>@(x.VisaType ?? "-")</td>
                    <td><span class="badge-soft">@(x.VisaStatus ?? "Pending")</span></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="3" class="empty-state">No pending visa applications.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
