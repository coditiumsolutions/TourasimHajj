@model TourismHajj.Models.Entities.FlightReservation
@{
    ViewData["Title"] = ViewData["Title"] ?? "Flight reservation";
}
@await Html.PartialAsync("_Alerts")
<div class="page-header">
    <div><h2>@ViewData["Title"]</h2></div>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Back</a>
</div>
<div class="card-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Provider</dt><dd class="col-sm-9">@Model.Provider</dd>
        <dt class="col-sm-3">Supplier ref</dt><dd class="col-sm-9">@(Model.SupplierBookingReference ?? "—")</dd>
        <dt class="col-sm-3">E-ticket</dt><dd class="col-sm-9">@(Model.TicketNumber ?? "—")</dd>
        <dt class="col-sm-3">Client ref</dt><dd class="col-sm-9">@(Model.ClientReference ?? "—")</dd>
        <dt class="col-sm-3">Flight</dt><dd class="col-sm-9">@(Model.CarrierName) · @Model.FlightNumber</dd>
        <dt class="col-sm-3">Route</dt><dd class="col-sm-9">@Model.Origin → @Model.Destination @(Model.IsRoundTrip ? "(RT)" : "")</dd>
        <dt class="col-sm-3">Schedule</dt><dd class="col-sm-9">@Model.DepartureAt.ToString("dd MMM yyyy HH:mm") → @Model.ArrivalAt.ToString("dd MMM yyyy HH:mm")</dd>
        <dt class="col-sm-3">Traveler</dt><dd class="col-sm-9">@Model.TravelerFirstName @Model.TravelerLastName · @(Model.Email ?? "") · @(Model.Phone ?? "")</dd>
        <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@((Model.SellingAmount ?? 0).ToString("0.##")) @Model.Currency</dd>
        <dt class="col-sm-3">Payment</dt><dd class="col-sm-9">@(Model.PaymentMethod ?? "—") · @(Model.PaymentStatus ?? "—")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Summary</dt><dd class="col-sm-9">@(Model.OfferSummary ?? "—")</dd>
    </dl>
</div>
