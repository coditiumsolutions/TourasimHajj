@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
    bool GroupOpen(params string[] controllers) =>
        controllers.Any(c => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase));

    var activeModule =
        GroupOpen("TravelPackages", "Destinations", "Services") ? "travel" :
        GroupOpen("HajjSeasons", "PilgrimGroups") ? "hajj" :
        GroupOpen("VisaApplications") ? "umrah" :
        GroupOpen("Customers", "Travelers") ? "customer" :
        GroupOpen("Suppliers", "Hotels", "TransportProviders") ? "supplier" :
        GroupOpen("Bookings") ? "booking" :
        GroupOpen("Payments", "SupplierPayments", "Expenses", "Refunds") ? "accounts" :
        GroupOpen("Reports") ? "reports" :
        GroupOpen("Employees", "Countries", "Cities") ? "administration" :
        "travel";
}

