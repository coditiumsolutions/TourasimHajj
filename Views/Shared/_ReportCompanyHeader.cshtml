        <div class="report-logo border rounded px-3 py-2 text-muted small">LOGO</div>
        <div>
            <h2 class="h4 mb-0">Al-Haram Travel</h2>
            <div class="text-muted small">Umrah &amp; Hajj Travel Management</div>
        </div>
    </div>
    @if (ViewData["ReportTitle"] is string title)
