@using Microsoft.AspNetCore.Identity
@using TourismHajj.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    @{ ViewData["InterfaceThemeScope"] = "customer"; }
    @await Html.PartialAsync("_InterfaceThemeStyles")
    <style>
        .customer-shell { display:flex; min-height:100vh; background:#eef2f6; }
        .customer-sidebar {
            width:260px;
            background:linear-gradient(180deg, var(--portal-primary, #0b1f3a), var(--portal-primary, #071526));
            color:#fff;
            flex-shrink:0;
        }
        .customer-sidebar a { color:rgba(255,255,255,.82); display:flex; gap:.7rem; align-items:center; padding:.7rem 1rem; border-radius:10px; text-decoration:none; }
        .customer-sidebar a:hover, .customer-sidebar a.active { background:rgba(255,255,255,.08); color:#fff; }
        .customer-main { flex:1; }
        .customer-top {
            background: var(--portal-secondary, #fff);
            border-bottom:1px solid rgba(0,0,0,.08);
            padding:1rem 1.25rem;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
        .customer-content { padding:1.35rem; }
        @@media (max-width: 991.98px) {
            .customer-shell { flex-direction:column; }
            .customer-sidebar { width:100%; }
        }
    </style>
</head>
<body>
<div class="customer-shell">
    <aside class="customer-sidebar p-3">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="brand-mark">TH</span>
            <div>
                <strong>Customer Portal</strong>
                <div class="small" style="opacity:.7;">My Travel Account</div>
            </div>
        </div>
        <nav class="d-grid gap-1">
            <a asp-controller="CustomerPortal" asp-action="Dashboard"><i class="fa-solid fa-gauge"></i> Dashboard</a>
            <a asp-controller="CustomerPortal" asp-action="Profile"><i class="fa-solid fa-user"></i> My Profile</a>
            <a asp-controller="CustomerPortal" asp-action="Travelers"><i class="fa-solid fa-users"></i> My Travelers</a>
            <a asp-controller="CustomerPortal" asp-action="Bookings"><i class="fa-solid fa-bookmark"></i> My Bookings</a>
            <a asp-controller="CustomerPortal" asp-action="Bookings" asp-route-type="Hajj"><i class="fa-solid fa-kaaba"></i> My Hajj Bookings</a>
            <a asp-controller="CustomerPortal" asp-action="Bookings" asp-route-type="Umrah"><i class="fa-solid fa-mosque"></i> My Umrah Bookings</a>
            <a asp-controller="CustomerPortal" asp-action="Payments"><i class="fa-solid fa-receipt"></i> My Payments</a>
            <a asp-controller="CustomerPortal" asp-action="Documents"><i class="fa-solid fa-folder-open"></i> My Documents</a>
            <a asp-controller="CustomerPortal" asp-action="Notifications"><i class="fa-solid fa-bell"></i> Notifications</a>
            <a href="/Identity/Account/Manage/ChangePassword"><i class="fa-solid fa-key"></i> Change Password</a>
            <form asp-controller="CustomerAccount" asp-action="Logout" method="post" class="mt-2">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-light w-100" type="submit"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</button>
            </form>
        </nav>
    </aside>
    <div class="customer-main">
        <div class="customer-top">
            <div>
                <strong>@ViewData["Title"]</strong>
                <div class="small text-muted">Signed in as @(UserManager.GetUserName(User))</div>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to Website</a>
        </div>
        <div class="customer-content">
            @RenderBody()
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<partial name="_Alerts" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
