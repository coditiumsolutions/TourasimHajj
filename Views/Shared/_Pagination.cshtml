@{
    var pageIndex = (int)(ViewData["PageIndex"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var search = ViewData["Search"] as string;
    var extraRouteValues = ViewData["RouteValues"] as IDictionary<string, string> ?? new Dictionary<string, string>();
}
@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@BuildRoute(pageIndex - 1, search, extraRouteValues)">Previous</a>
            </li>
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="@BuildRoute(p, search, extraRouteValues)">@p</a>
                </li>
            }
            <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@BuildRoute(pageIndex + 1, search, extraRouteValues)">Next</a>
            </li>
        </ul>
    </nav>
}
@functions {
    IDictionary<string, string> BuildRoute(int page, string? search, IDictionary<string, string> extras)
    {
        var route = new Dictionary<string, string>(extras) { ["page"] = page.ToString() };
        if (!string.IsNullOrWhiteSpace(search))
        {
            route["search"] = search;
        }
        return route;
    }
}