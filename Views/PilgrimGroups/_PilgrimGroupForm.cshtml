@model PilgrimGroupInputModel
<div class="row g-3">
    <div class="col-md-4"><label asp-for="HajjSeasonId" class="form-label"></label><select asp-for="HajjSeasonId" class="form-select" asp-items="@(new SelectList(Model.SeasonOptions, nameof(HajjSeason.HajjSeasonId), nameof(HajjSeason.SeasonName)))"></select></div>
    <div class="col-md-4"><label asp-for="DepartureId" class="form-label"></label><select asp-for="DepartureId" class="form-select"><option value="">—</option>@foreach (var d in Model.DepartureOptions){<option value="@d.DepartureId">@d.DepartureDate — @d.Package?.PackageName</option>}</select></div>
    <div class="col-md-4"><label asp-for="GroupCode" class="form-label"></label><input asp-for="GroupCode" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="GroupName" class="form-label"></label><input asp-for="GroupName" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="GroupStatus" class="form-label"></label><input asp-for="GroupStatus" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="GroupLeaderName" class="form-label"></label><input asp-for="GroupLeaderName" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="GroupLeaderMobile" class="form-label"></label><input asp-for="GroupLeaderMobile" class="form-control" /></div>
    <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control"></textarea></div>
</div>
<div class="mt-3">
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</div>