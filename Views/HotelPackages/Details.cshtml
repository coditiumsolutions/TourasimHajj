@model TourismHajj.Models.Entities.HotelPackage
@{ ViewData["Title"] = "Hotel Package Details"; }
<div class="page-header">
    <h2>@Model.HotelName</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.HotelPackageId">Edit</a>
        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@Model.HotelPackageId">Deactivate</a>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Back to list</a>
    </div>
</div>
<div class="card-panel"><div class="card-panel-body">
    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="@Model.HotelName" class="mb-3" style="max-height:180px;border-radius:8px;" />
    }
    <dl class="row mb-0">
        <dt class="col-sm-3">City</dt><dd class="col-sm-9">@(Model.CityName ?? "—")</dd>
        <dt class="col-sm-3">Stars</dt><dd class="col-sm-9">@(Model.StarRating?.ToString() ?? "—")</dd>
        <dt class="col-sm-3">Price / Night</dt>
        <dd class="col-sm-9">@(Model.PricePerNight.HasValue ? $"{Model.PricePerNight:N0} {Model.CurrencyCode ?? "PKR"}" : "—")</dd>
        <dt class="col-sm-3">Nights</dt><dd class="col-sm-9">@(Model.DurationNights?.ToString() ?? "—")</dd>
        <dt class="col-sm-3">Haram / Nabawi</dt>
        <dd class="col-sm-9">@Model.DistanceFromHaramKm km / @Model.DistanceFromNabawiKm km</dd>
        <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@(Model.ContactNo ?? "—")</dd>
        <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@(Model.Address ?? "—")</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@(Model.Description ?? "—")</dd>
        <dt class="col-sm-3">Featured</dt><dd class="col-sm-9">@(Model.IsFeatured ? "Yes" : "No")</dd>
        <dt class="col-sm-3">Active</dt><dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
    </dl>
</div></div>
