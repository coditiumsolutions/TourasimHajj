@model TourismHajj.Models.Entities.City
@{ ViewData["Title"] = "Cities Details"; }
<div class="page-header"><h2>Cities Details</h2><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.CityId">Edit</a></div>
<div class="card-panel"><div class="card-panel-body"><dl class="row mb-0"><dt class="col-sm-3">City</dt><dd class="col-sm-9">@Model.CityName</dd><dt class="col-sm-3">Country Id</dt><dd class="col-sm-9">@Model.CountryId</dd><dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.IsActive</dd></dl></div></div>
