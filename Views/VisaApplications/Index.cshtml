@model VisaApplicationListViewModel
@{ ViewData["Title"] = "Visa Applications"; }
@await Html.PartialAsync("_Alerts")
<div class="page-header">
    <div><h2>Visa Applications</h2></div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input class="form-control form-control-sm" name="status" value="@Model.StatusFilter" placeholder="Status..." />
            <button class="btn btn-sm btn-outline-secondary" type="submit">Filter</button>
        </form>
        <a class="btn btn-sm btn-accent" asp-action="Create"><i class="fa-solid fa-plus"></i> Add</a>
    </div>
</div>
<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Traveler</th>
                    <th>Type</th>
                    <th>Country</th>
                    <th>Status</th>
                    <th>App No</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Applications)
            {
                <tr>
                    <td>@item.BookingTraveler?.Traveler?.FullName</td>
                    <td>@item.VisaType</td>
                    <td>@item.Country?.CountryName</td>
                    <td>@item.VisaStatus</td>
                    <td>@item.ApplicationNumber</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.VisaApplicationId"><i class="fa-solid fa-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.VisaApplicationId"><i class="fa-solid fa-pen"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
