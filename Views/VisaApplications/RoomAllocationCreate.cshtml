@model RoomAllocationInputModel
@{
    ViewData["Title"] = "Assign Room";
}
<div class="page-header"><h1 class="h3 mb-0">Assign Room</h1></div>
<form asp-action="CreateRoom" method="post" class="card-panel p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="BookingTravelerId" class="form-label"></label>
            <select asp-for="BookingTravelerId" class="form-select" asp-items="@(new SelectList(Model.TravelerOptions, nameof(BookingTravelerOption.BookingTravelerId), nameof(BookingTravelerOption.DisplayName)))"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="HotelId" class="form-label"></label>
            <select asp-for="HotelId" class="form-select" asp-items="@(new SelectList(Model.HotelOptions, nameof(Hotel.HotelId), nameof(Hotel.HotelName)))"></select>
        </div>
        <div class="col-md-3"><label asp-for="RoomNumber" class="form-label"></label><input asp-for="RoomNumber" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="RoomType" class="form-label"></label><input asp-for="RoomType" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="CheckInDate" class="form-label"></label><input asp-for="CheckInDate" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="CheckOutDate" class="form-label"></label><input asp-for="CheckOutDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="SharingType" class="form-label"></label><input asp-for="SharingType" class="form-control" /></div>
        <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="RoomAllocations" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }