@model VisaApplicationInputModel
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="@(Model.VisaApplicationId > 0 ? "Edit" : "Create")" method="post" class="form-4col">
            <input type="hidden" asp-for="VisaApplicationId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="BookingTravelerId">Booking Traveler</label>
                <div class="form-4col-field">
                    <select asp-for="BookingTravelerId" class="form-select" asp-items="@(new SelectList(Model.TravelerOptions, nameof(BookingTravelerOption.BookingTravelerId), nameof(BookingTravelerOption.DisplayName)))"></select>
                    <span asp-validation-for="BookingTravelerId" class="text-danger"></span>
                </div>
                <label class="form-4col-label" asp-for="VisaType">Visa Type</label>
                <div class="form-4col-field">
                    <input asp-for="VisaType" class="form-control" />
                    <span asp-validation-for="VisaType" class="text-danger"></span>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="CountryId">Country</label>
                <div class="form-4col-field">
                    <select asp-for="CountryId" class="form-select" asp-items="@(new SelectList(Model.CountryOptions, nameof(Country.CountryId), nameof(Country.CountryName)))"></select>
                    <span asp-validation-for="CountryId" class="text-danger"></span>
                </div>
                <label class="form-4col-label" asp-for="VisaStatus">Status</label>
                <div class="form-4col-field">
                    <input asp-for="VisaStatus" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="SupplierId">Supplier</label>
                <div class="form-4col-field">
                    <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.SupplierOptions, nameof(Supplier.SupplierId), nameof(Supplier.SupplierName)))">
                        <option value="">— Optional —</option>
                    </select>
                </div>
                <label class="form-4col-label" asp-for="ApplicationDate">Application Date</label>
                <div class="form-4col-field">
                    <input asp-for="ApplicationDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="ApplicationNumber">Application No</label>
                <div class="form-4col-field">
                    <input asp-for="ApplicationNumber" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="VisaNumber">Visa No</label>
                <div class="form-4col-field">
                    <input asp-for="VisaNumber" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="SubmissionDate">Submission Date</label>
                <div class="form-4col-field">
                    <input asp-for="SubmissionDate" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="ApprovalDate">Approval Date</label>
                <div class="form-4col-field">
                    <input asp-for="ApprovalDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="VisaIssueDate">Issue Date</label>
                <div class="form-4col-field">
                    <input asp-for="VisaIssueDate" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="VisaExpiryDate">Expiry Date</label>
                <div class="form-4col-field">
                    <input asp-for="VisaExpiryDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="Remarks">Remarks</label>
                <div class="form-4col-field">
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>
                <span></span>
                <span></span>
            </div>

            <div class="form-4col-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>