@model VisaApplicationInputModel
<form asp-action="@(Model.VisaApplicationId > 0 ? "Edit" : "Create")" method="post" class="card-panel p-4">
    <input type="hidden" asp-for="VisaApplicationId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="BookingTravelerId" class="form-label"></label>
            <select asp-for="BookingTravelerId" class="form-select" asp-items="@(new SelectList(Model.TravelerOptions, nameof(BookingTravelerOption.BookingTravelerId), nameof(BookingTravelerOption.DisplayName)))"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="VisaType" class="form-label"></label>
            <input asp-for="VisaType" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="VisaStatus" class="form-label"></label>
            <input asp-for="VisaStatus" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="CountryId" class="form-label"></label>
            <select asp-for="CountryId" class="form-select" asp-items="@(new SelectList(Model.CountryOptions, nameof(Country.CountryId), nameof(Country.CountryName)))"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.SupplierOptions, nameof(Supplier.SupplierId), nameof(Supplier.SupplierName)))">
                <option value="">— Optional —</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="ApplicationDate" class="form-label"></label>
            <input asp-for="ApplicationDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4"><label asp-for="ApplicationNumber" class="form-label"></label><input asp-for="ApplicationNumber" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="VisaNumber" class="form-label"></label><input asp-for="VisaNumber" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="SubmissionDate" class="form-label"></label><input asp-for="SubmissionDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="ApprovalDate" class="form-label"></label><input asp-for="ApprovalDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="VisaIssueDate" class="form-label"></label><input asp-for="VisaIssueDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="VisaExpiryDate" class="form-label"></label><input asp-for="VisaExpiryDate" type="date" class="form-control" /></div>
        <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>