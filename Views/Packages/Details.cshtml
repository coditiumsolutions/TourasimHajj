@model PublicPackageDetailsViewModel
@using Microsoft.Extensions.Options
@using TourismHajj.Helpers
@inject IOptions<CompanyProfileOptions> CompanyOptions
@{
    Layout = "_PublicLayout";
    var p = Model.Package;
    var isHajj = Model.IsHajjEnquiryOnly;
    var whatsapp = (CompanyOptions.Value.WhatsApp ?? "").Trim().TrimStart('+');
}
<section class="package-hero" style="background-image:url('@Model.CoverImageUrl');">
    <div class="container-xl package-hero-content">
        <span class="badge-type bg-warning text-dark">@p.PackageType</span>
        <h1 class="mt-2 mb-2">@p.PackageName</h1>
        <p class="mb-0">@(Model.DestinationSummary ?? "Curated itinerary") · @(p.DurationDays ?? 0) days / @(p.DurationNights ?? 0) nights</p>
    </div>
</section>

<section class="section-pad">
    <div class="container-xl">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="contact-panel mb-4">
                    <h3>Overview</h3>
                    <p>@(p.Description ?? "Package details will be updated by the travel operations team.")</p>
                    <div class="price mb-3">From @(p.CurrencyCode ?? "PKR") @((p.AdultPrice ?? 0).ToString("N0"))</div>
                    @if (isHajj)
                    {
                        <div class="alert alert-warning">
                            Hajj in Bahrain is arranged only through Ministry of Hajj approved campaigns / Nusuk.
                            Online ticket sales are not available — register your interest and our licensed team will call you.
                        </div>
                        <a class="btn-gold" asp-controller="Contact" asp-action="Index" asp-route-subject="@($"Hajj interest — {p.PackageName}")">Register interest</a>
                        <a class="btn btn-outline-secondary ms-2" href="https://wa.me/@whatsapp?text=@Uri.EscapeDataString($"Hajj interest: {p.PackageName}")" target="_blank" rel="noopener">WhatsApp</a>
                    }
                    else
                    {
                        <a class="btn-gold" asp-controller="Packages" asp-action="Book" asp-route-id="@p.PackageId">Book Now</a>
                        <a class="btn btn-outline-secondary ms-2" href="/Flights">Search flights</a>
                        <a class="btn btn-outline-secondary ms-2" href="/Hotels">Search hotels</a>
                    }
                </div>

                @if (!isHajj)
                {
                    <div class="contact-panel mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h3 class="mb-0">Flights (Amadeus)</h3>
                            @if (Model.FlightsDemoMode)
                            {
                                <span class="badge bg-secondary">Demo</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Live</span>
                            }
                        </div>
                        <p class="text-muted small">Bahrain (BAH) → Jeddah (JED) sample offers for this package’s dates. Select a flight to book and receive an e-ticket.</p>
                        @if (!Model.SuggestedFlights.Any())
                        {
                            <p class="mb-2">No offers loaded. <a href="/Flights">Open flight search</a>.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush mb-3">
                                @foreach (var f in Model.SuggestedFlights)
                                {
                                    <div class="list-group-item px-0 d-flex flex-wrap justify-content-between gap-2 align-items-center">
                                        <div>
                                            <strong>@f.CarrierName · @f.FlightNumber</strong>
                                            <div class="small text-muted">@f.Origin → @f.Destination · @f.DepartureAt.ToString("dd MMM HH:mm") · @(f.Stops == 0 ? "Non-stop" : f.Stops + " stop")</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-semibold">@f.TotalPrice.ToString("0.##") @f.Currency</div>
                                            <a class="btn btn-sm btn-outline-primary" href="/Flights/Book?offerId=@Uri.EscapeDataString(f.OfferId)">Select</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        <a class="btn btn-sm btn-outline-secondary" href="/Flights">See all flights</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/Hotels">Hotels (Hotelbeds)</a>
                    </div>
                }

                <div class="contact-panel mb-4">
                    <h3>Daily Itinerary</h3>
                    @if (!Model.Itineraries.Any())
                    {
                        <p class="text-muted mb-0">Itinerary will be published soon.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var day in Model.Itineraries)
                            {
                                <div class="list-group-item px-0">
                                    <strong>Day @day.DayNumber — @(day.Title ?? "Program")</strong>
                                    <div class="text-muted">@day.Description</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="contact-panel h-100">
                            <h4>Included</h4>
                            <ul>
                                @foreach (var s in Model.IncludedServices)
                                {
                                    <li>@(s.Service?.ServiceName ?? "Service")</li>
                                }
                                @if (!Model.IncludedServices.Any()) { <li class="text-muted">Details available on request.</li> }
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="contact-panel h-100">
                            <h4>Excluded</h4>
                            <ul>
                                @foreach (var s in Model.ExcludedServices)
                                {
                                    <li>@(s.Service?.ServiceName ?? "Service")</li>
                                }
                                @if (!Model.ExcludedServices.Any()) { <li class="text-muted">No exclusions listed.</li> }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="contact-panel mb-4">
                    <h4>Departures</h4>
                    @foreach (var d in Model.Departures)
                    {
                        <div class="border-bottom py-2">
                            <strong>@d.DepartureDate.ToString("dd MMM yyyy")</strong>
                            <div class="small text-muted">Seats available: @(d.AvailableSeats ?? 0)</div>
                        </div>
                    }
                    @if (!Model.Departures.Any())
                    {
                        <p class="text-muted mb-0">No upcoming departures listed.</p>
                    }
                </div>
                <div class="contact-panel">
                    <h4>Hotels</h4>
                    @foreach (var h in Model.Hotels)
                    {
                        <div class="mb-2">
                            <strong>@h.HotelName</strong>
                            <div class="small text-muted">@h.City?.CityName · @(h.StarRating?.ToString() ?? "-")★</div>
                        </div>
                    }
                    @if (!Model.Hotels.Any())
                    {
                        <p class="text-muted mb-0">Hotel allocation confirmed after booking. <a href="/Hotels">Browse live hotels</a>.</p>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-secondary mt-2" href="/Hotels">Live Hotelbeds search</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
