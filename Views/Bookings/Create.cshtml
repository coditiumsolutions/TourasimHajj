@model TourismHajj.ViewModels.BookingCreateViewModel
@{ ViewData["Title"] = "New Booking"; }
@await Html.PartialAsync("_Alerts")
<div class="page-header"><h2>New Booking</h2></div>
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="Create" method="post" class="form-4col">
            @Html.AntiForgeryToken()

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="CustomerId">Customer</label>
                <div class="form-4col-field">
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers"></select>
                </div>
                <label class="form-4col-label" asp-for="PackageId">Package</label>
                <div class="form-4col-field">
                    <select asp-for="PackageId" class="form-select" asp-items="ViewBag.Packages"></select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="DepartureId">Departure</label>
                <div class="form-4col-field">
                    <select asp-for="DepartureId" class="form-select" asp-items="ViewBag.Departures">
                        <option value="">-- Optional --</option>
                    </select>
                </div>
                <label class="form-4col-label" asp-for="BookingType">Booking Type</label>
                <div class="form-4col-field">
                    <input asp-for="BookingType" class="form-control" placeholder="Tourism / Hajj / Umrah" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="TotalAdults">Adults</label>
                <div class="form-4col-field">
                    <input asp-for="TotalAdults" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="TotalChildren">Children</label>
                <div class="form-4col-field">
                    <input asp-for="TotalChildren" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="TotalInfants">Infants</label>
                <div class="form-4col-field">
                    <input asp-for="TotalInfants" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="DiscountAmount">Discount</label>
                <div class="form-4col-field">
                    <input asp-for="DiscountAmount" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="TaxAmount">Tax</label>
                <div class="form-4col-field">
                    <input asp-for="TaxAmount" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="InitialPayment">Initial Payment</label>
                <div class="form-4col-field">
                    <input asp-for="InitialPayment" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="TravelerIds">Travelers</label>
                <div class="form-4col-field">
                    <select asp-for="TravelerIds" class="form-select" asp-items="ViewBag.Travelers" multiple size="6"></select>
                </div>
                <label class="form-4col-label" asp-for="PaymentMethod">Payment Method</label>
                <div class="form-4col-field">
                    <select asp-for="PaymentMethod" class="form-select">
                        <option>Cash</option>
                        <option>Bank Transfer</option>
                        <option>Card</option>
                    </select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="Remarks">Remarks</label>
                <div class="form-4col-field">
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>
                <span></span>
                <span></span>
            </div>

            <div class="form-4col-actions">
                <button class="btn btn-primary" type="submit">Save Booking</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>