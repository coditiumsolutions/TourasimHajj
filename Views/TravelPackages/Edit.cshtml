@model PackageEditViewModel
@{
    ViewData["Title"] = "Edit Package";
    var p = Model.Basic;
}
@await Html.PartialAsync("_AlertMessages")
<div class="page-header"><h2>@p.PackageName <small class="text-muted">(@p.PackageCode)</small></h2></div>
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#basic" type="button">Basic</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#itinerary" type="button">Itinerary</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#services" type="button">Services</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#departures" type="button">Departures</button></li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="basic">
        <div class="card-panel"><div class="card-panel-body">
            <form asp-action="EditBasic" method="post" enctype="multipart/form-data" class="form-4col">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Package.PackageId" value="@p.PackageId" />

                <div class="form-4col-row">
                    <label class="form-4col-label" for="Package_PackageCode">Code</label>
                    <div class="form-4col-field">
                        <input name="Package.PackageCode" id="Package_PackageCode" value="@p.PackageCode" class="form-control" />
                    </div>
                    <label class="form-4col-label" for="Package_PackageName">Name</label>
                    <div class="form-4col-field">
                        <input name="Package.PackageName" id="Package_PackageName" value="@p.PackageName" class="form-control" />
                    </div>
                </div>

                <div class="form-4col-row">
                    <label class="form-4col-label" for="Package_PackageType">Type</label>
                    <div class="form-4col-field">
                        <input name="Package.PackageType" id="Package_PackageType" value="@p.PackageType" class="form-control" />
                    </div>
                    <label class="form-4col-label" for="Package_DurationDays">Days</label>
                    <div class="form-4col-field">
                        <input name="Package.DurationDays" id="Package_DurationDays" value="@p.DurationDays" class="form-control" />
                    </div>
                </div>

                <div class="form-4col-row">
                    <label class="form-4col-label" for="Package_Description">Description</label>
                    <div class="form-4col-field">
                        <textarea name="Package.Description" id="Package_Description" class="form-control" rows="3">@p.Description</textarea>
                    </div>
                    <label class="form-4col-label" for="Package_DurationNights">Nights</label>
                    <div class="form-4col-field">
                        <input name="Package.DurationNights" id="Package_DurationNights" value="@p.DurationNights" class="form-control" />
                    </div>
                </div>

                <div class="form-4col-row">
                    <label class="form-4col-label" for="Package_AdultPrice">Adult</label>
                    <div class="form-4col-field">
                        <input name="Package.AdultPrice" id="Package_AdultPrice" value="@p.AdultPrice" class="form-control" />
                    </div>
                    <label class="form-4col-label" for="Package_ChildPrice">Child</label>
                    <div class="form-4col-field">
                        <input name="Package.ChildPrice" id="Package_ChildPrice" value="@p.ChildPrice" class="form-control" />
                    </div>
                </div>

                <div class="form-4col-row">
                    <label class="form-4col-label" for="Package_InfantPrice">Infant</label>
                    <div class="form-4col-field">
                        <input name="Package.InfantPrice" id="Package_InfantPrice" value="@p.InfantPrice" class="form-control" />
                    </div>
                    <label class="form-4col-label" for="Package_CurrencyCode">Currency</label>
                    <div class="form-4col-field">
                        <input name="Package.CurrencyCode" id="Package_CurrencyCode" value="@p.CurrencyCode" class="form-control" />
                    </div>
                </div>

                <div class="form-4col-row">
                    <label class="form-4col-label" for="Package_IsFeatured">Featured</label>
                    <div class="form-4col-field form-4col-check">
                        <input name="Package.IsFeatured" type="checkbox" value="true" id="Package_IsFeatured" class="form-check-input" @(p.IsFeatured == true ? "checked" : null) />
                    </div>
                    <label class="form-4col-label" for="Package_IsActive">Active</label>
                    <div class="form-4col-field form-4col-check">
                        <input name="Package.IsActive" type="checkbox" value="true" id="Package_IsActive" class="form-check-input" @(p.IsActive == true ? "checked" : null) />
                    </div>
                </div>

                <div class="form-4col-row">
                    <label class="form-4col-label" for="coverImage">Package Image</label>
                    <div class="form-4col-field">
                        <input type="file" class="form-control" id="coverImage" name="coverImage" accept="image/jpeg,image/png,image/webp,image/gif" />
                        <div class="form-text">Upload a new image to replace the current one (JPG/PNG/WEBP/GIF, max 5 MB).</div>
                        @if (!string.IsNullOrWhiteSpace(p.CoverImageUrl))
                        {
                            <div class="mt-2">
                                <img src="@p.CoverImageUrl" alt="@p.PackageName" style="max-width: 220px; max-height: 140px; object-fit: cover; border-radius: 10px; border: 1px solid #dee2e6;" />
                            </div>
                        }
                    </div>
                    <label class="form-4col-label" for="Package_CoverImageUrl">Or Image URL</label>
                    <div class="form-4col-field">
                        <input name="Package.CoverImageUrl" id="Package_CoverImageUrl" value="@p.CoverImageUrl" class="form-control" placeholder="https://... or /uploads/packages/..." />
                    </div>
                </div>

                <div class="form-4col-actions">
                    <button class="btn btn-primary" type="submit">Save Basic Info</button>
                </div>
            </form>
        </div></div>
    </div>

    <div class="tab-pane fade" id="itinerary">
        <div class="card-panel"><div class="card-panel-header"><h5>Day-wise Itinerary</h5></div>
            <div class="card-panel-body">
                <table class="table table-sm">
                    <thead><tr><th>Day</th><th>Title</th><th>Description</th></tr></thead>
                    <tbody>
                    @foreach (var i in Model.Itineraries)
                    {
                        <tr><td>@i.DayNumber</td><td>@i.Title</td><td>@i.Description</td></tr>
                    }
                    @if (!Model.Itineraries.Any())
                    {
                        <tr><td colspan="3" class="text-muted">No itinerary yet</td></tr>
                    }
                    </tbody>
                </table>
                <form asp-action="AddItinerary" method="post" class="form-4col">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PackageId" value="@p.PackageId" />

                    <div class="form-4col-row">
                        <label class="form-4col-label" for="DayNumber">Day #</label>
                        <div class="form-4col-field">
                            <input name="DayNumber" id="DayNumber" class="form-control" placeholder="Day #" />
                        </div>
                        <label class="form-4col-label" for="Title">Title</label>
                        <div class="form-4col-field">
                            <input name="Title" id="Title" class="form-control" placeholder="Title" />
                        </div>
                    </div>

                    <div class="form-4col-row">
                        <label class="form-4col-label" for="Description">Description</label>
                        <div class="form-4col-field">
                            <input name="Description" id="Description" class="form-control" placeholder="Description" />
                        </div>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="form-4col-actions">
                        <button class="btn btn-primary" type="submit">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="services">
        <div class="card-panel"><div class="card-panel-header"><h5>Package Services</h5></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Service</th><th>Included</th><th>Extra Price</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Services)
                    {
                        <tr><td>@s.ServiceName</td><td>@(s.IsIncluded ? "Yes" : "No")</td><td>@s.AdditionalPrice</td></tr>
                    }
                    @if (!Model.Services.Any())
                    {
                        <tr><td colspan="3" class="text-muted text-center">No services linked</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="departures">
        <div class="card-panel"><div class="card-panel-header"><h5>Departures &amp; Seats</h5></div>
            <div class="card-panel-body">
                <table class="table table-sm">
                    <thead><tr><th>Departure</th><th>Return</th><th>Seats</th><th>Available</th><th>Adult</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model.Departures)
                    {
                        <tr><td>@d.DepartureDate</td><td>@d.ReturnDate</td><td>@d.TotalSeats</td><td>@d.AvailableSeats</td><td>@d.AdultPrice</td><td>@d.DepartureStatus</td></tr>
                    }
                    @if (!Model.Departures.Any())
                    {
                        <tr><td colspan="6" class="text-muted">No departures</td></tr>
                    }
                    </tbody>
                </table>
                <form asp-action="AddDeparture" method="post" class="form-4col">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PackageId" value="@p.PackageId" />

                    <div class="form-4col-row">
                        <label class="form-4col-label" for="DepartureDate">Departure</label>
                        <div class="form-4col-field">
                            <input name="DepartureDate" id="DepartureDate" type="date" class="form-control" required />
                        </div>
                        <label class="form-4col-label" for="ReturnDate">Return</label>
                        <div class="form-4col-field">
                            <input name="ReturnDate" id="ReturnDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-4col-row">
                        <label class="form-4col-label" for="TotalSeats">Total Seats</label>
                        <div class="form-4col-field">
                            <input name="TotalSeats" id="TotalSeats" class="form-control" placeholder="Total seats" />
                        </div>
                        <label class="form-4col-label" for="AdultPrice">Adult Price</label>
                        <div class="form-4col-field">
                            <input name="AdultPrice" id="AdultPrice" class="form-control" placeholder="Adult price" />
                        </div>
                    </div>

                    <div class="form-4col-row">
                        <label class="form-4col-label" for="CurrencyCode">Currency</label>
                        <div class="form-4col-field">
                            <input name="CurrencyCode" id="CurrencyCode" class="form-control" value="@(p.CurrencyCode ?? "PKR")" />
                        </div>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="form-4col-actions">
                        <button class="btn btn-primary" type="submit">Add Departure</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>