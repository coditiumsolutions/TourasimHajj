@model ReportFilterViewModel
@{ ViewData["Title"] = Model.ReportTitle; }
@await Html.PartialAsync("_Alerts")
<div class="page-header no-print">
    <div><h2>@Model.ReportTitle</h2></div>
    <button class="btn btn-sm btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print</button>
</div>
<div class="card-panel no-print mb-3"><div class="card-panel-body">
<form method="post" asp-action="@Model.ReportAction" class="row g-2 align-items-end">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReportTitle" />
    <input type="hidden" asp-for="ReportAction" />
    <div class="col-md-3"><label class="form-label">From</label><input asp-for="FromDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">To</label><input asp-for="ToDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">Package Type</label><input asp-for="PackageType" class="form-control" /></div>
    <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Apply Filters</button></div>
</form></div></div>
<div class="card-panel"><div class="card-panel-body">
    <div class="d-flex justify-content-between mb-3">
        <div><h4 class="mb-0">Al-Haram Travel</h4><div class="text-muted">Travel &amp; Pilgrimage Management</div></div>
        <div class="text-end"><h5>@Model.ReportTitle</h5><div>@DateTime.Now.ToString("dd-MMM-yyyy HH:mm")</div></div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <tbody>
            @if (ViewBag.Rows != null)
            {
                @foreach (var row in (System.Collections.IEnumerable)ViewBag.Rows)
                {
                    <tr>
                        @foreach (var prop in row.GetType().GetProperties())
                        {
                            <td>@prop.GetValue(row)</td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr><td class="text-muted text-center">Submit filters to load report data.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div></div>
