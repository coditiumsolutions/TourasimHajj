@model HotelListViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Hotels";
}
@await Html.PartialAsync("_Alerts")
<div class="page-header">
    <div>
        <h2>@ViewData["Title"]</h2>
        @if (Model.IncludeInactive)
        {
            <p class="text-muted mb-0 small">Showing inactive hotels</p>
        }
    </div>
    <div class="d-flex gap-2">
        @if (Model.IncludeInactive)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Active Hotels</a>
        }
        else
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-includeInactive="true">Inactive</a>
        }
        <a class="btn btn-sm btn-accent" asp-action="Create"><i class="fa-solid fa-plus"></i> Add Hotel</a>
    </div>
</div>
<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>City</th>
                    <th>Stars</th>
                    <th>Haram KM</th>
                    <th>Nabawi KM</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Hotels)
            {
                <tr>
                    <td>@item.HotelName</td>
                    <td>@item.City?.CityName</td>
                    <td>@item.StarRating</td>
                    <td>@item.DistanceFromHaramKm</td>
                    <td>@item.DistanceFromNabawiKm</td>
                    <td>@(item.IsActive == true ? "Yes" : "No")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.HotelId" title="Details"><i class="fa-solid fa-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.HotelId" title="Edit"><i class="fa-solid fa-pen"></i></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.HotelId" title="Deactivate"><i class="fa-solid fa-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Hotels.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hotels found.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
