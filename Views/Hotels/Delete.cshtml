@model Hotel
@{
    ViewData["Title"] = "Delete Hotel";
}
<div class="page-header"><h1 class="h3 text-danger mb-0">Deactivate Hotel</h1></div>
<div class="card-panel p-4">
    <p>Deactivate hotel <strong>@Model.HotelName</strong> in @Model.City?.CityName?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="HotelId" />
        <button type="submit" class="btn btn-danger" data-confirm="Deactivate this hotel?">Confirm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>