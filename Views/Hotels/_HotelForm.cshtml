@model HotelInputModel
<form asp-action="@(Model.HotelId > 0 ? "Edit" : "Create")" method="post" class="card-panel p-4">
    <input type="hidden" asp-for="HotelId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="HotelName" class="form-label"></label>
            <input asp-for="HotelName" class="form-control" />
            <span asp-validation-for="HotelName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="StarRating" class="form-label"></label>
            <input asp-for="StarRating" class="form-control" type="number" min="1" max="7" />
        </div>
        <div class="col-md-6">
            <label asp-for="CityId" class="form-label"></label>
            <select asp-for="CityId" class="form-select" asp-items="@(new SelectList(Model.CityOptions, nameof(City.CityId), nameof(City.CityName)))"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.SupplierOptions, nameof(Supplier.SupplierId), nameof(Supplier.SupplierName)))">
                <option value="">— Optional —</option>
            </select>
        </div>
        <div class="col-md-4"><label asp-for="DistanceFromHaramKm" class="form-label"></label><input asp-for="DistanceFromHaramKm" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="DistanceFromNabawiKm" class="form-label"></label><input asp-for="DistanceFromNabawiKm" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="ContactNo" class="form-label"></label><input asp-for="ContactNo" class="form-control" /></div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div>
        <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>