@model HotelInputModel
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="@(Model.HotelId > 0 ? "Edit" : "Create")" method="post" class="form-4col">
            <input type="hidden" asp-for="HotelId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="HotelName">Hotel Name</label>
                <div class="form-4col-field">
                    <input asp-for="HotelName" class="form-control" />
                    <span asp-validation-for="HotelName" class="text-danger"></span>
                </div>
                <label class="form-4col-label" asp-for="StarRating">Star Rating</label>
                <div class="form-4col-field">
                    <input asp-for="StarRating" class="form-control" type="number" min="1" max="7" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="CityId">City</label>
                <div class="form-4col-field">
                    <select asp-for="CityId" class="form-select" asp-items="@(new SelectList(Model.CityOptions, nameof(City.CityId), nameof(City.CityName)))"></select>
                </div>
                <label class="form-4col-label" asp-for="SupplierId">Supplier</label>
                <div class="form-4col-field">
                    <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.SupplierOptions, nameof(Supplier.SupplierId), nameof(Supplier.SupplierName)))">
                        <option value="">— Optional —</option>
                    </select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="DistanceFromHaramKm">Distance From Haram Km</label>
                <div class="form-4col-field">
                    <input asp-for="DistanceFromHaramKm" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="DistanceFromNabawiKm">Distance From Nabawi Km</label>
                <div class="form-4col-field">
                    <input asp-for="DistanceFromNabawiKm" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="ContactNo">Contact No</label>
                <div class="form-4col-field">
                    <input asp-for="ContactNo" class="form-control" />
                </div>
                <label class="form-4col-label" for="IsActive">Active</label>
                <div class="form-4col-field form-4col-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : null) />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="Address">Address</label>
                <div class="form-4col-field">
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
                <span></span>
                <span></span>
            </div>

            <div class="form-4col-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>