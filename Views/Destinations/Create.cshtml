@model TourismHajj.Models.Entities.Destination
@{ ViewData["Title"] = "New Destination"; }
<div class="page-header"><h2>@ViewData["Title"]</h2></div>
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="Create" method="post" class="form-4col">
            @Html.AntiForgeryToken()

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="DestinationName">Name</label>
                <div class="form-4col-field">
                    <input asp-for="DestinationName" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="CityId">City</label>
                <div class="form-4col-field">
                    <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities"></select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" for="IsFeatured">Featured</label>
                <div class="form-4col-field form-4col-check">
                    <input type="checkbox" class="form-check-input" id="IsFeatured" name="IsFeatured" value="true" @(Model.IsFeatured == true ? "checked" : null) />
                </div>
                <label class="form-4col-label" for="IsActive">Active</label>
                <div class="form-4col-field form-4col-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : null) />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="Description">Description</label>
                <div class="form-4col-field">
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <span></span>
                <span></span>
            </div>

            <div class="form-4col-actions">
                <button class="btn btn-primary" type="submit">Save</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>