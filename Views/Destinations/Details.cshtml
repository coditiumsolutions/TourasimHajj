@model TourismHajj.Models.Entities.Destination
@{ ViewData["Title"] = "Destinations Details"; }
<div class="page-header"><h2>Destinations Details</h2><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.DestinationId">Edit</a></div>
<div class="card-panel"><div class="card-panel-body"><dl class="row mb-0"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.DestinationName</dd><dt class="col-sm-3">City</dt><dd class="col-sm-9">@Model.CityId</dd><dt class="col-sm-3">Featured</dt><dd class="col-sm-9">@Model.IsFeatured</dd><dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.IsActive</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd></dl></div></div>
