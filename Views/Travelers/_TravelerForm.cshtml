@model TravelerInputModel
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="@(Model.TravelerId > 0 ? "Edit" : "Create")" method="post">
            <input type="hidden" asp-for="TravelerId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CustomerId" class="form-label"></label>
                    <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-4"><label asp-for="FatherName" class="form-label"></label><input asp-for="FatherName" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" asp-items="ViewBag.Genders" class="form-select"><option value="">--</option></select></div>
                <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" type="date" /></div>
                <div class="col-md-6"><label asp-for="NationalityCountryId" class="form-label"></label><select asp-for="NationalityCountryId" asp-items="ViewBag.NationalityCountryId" class="form-select"><option value="">--</option></select></div>
                <div class="col-md-6"><label asp-for="Relationship" class="form-label"></label><input asp-for="Relationship" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Cnic" class="form-label"></label><input asp-for="Cnic" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="PassportNo" class="form-label"></label><input asp-for="PassportNo" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="MobileNo" class="form-label"></label><input asp-for="MobileNo" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="PassportIssueDate" class="form-label"></label><input asp-for="PassportIssueDate" class="form-control" type="date" /></div>
                <div class="col-md-6"><label asp-for="PassportExpiryDate" class="form-label"></label><input asp-for="PassportExpiryDate" class="form-control" type="date" /></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }