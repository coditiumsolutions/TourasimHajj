@model TourismHajj.Models.Entities.Traveler
@{ ViewData["Title"] = "Edit Traveler"; }
<div class="page-header"><h2>Edit Traveler</h2></div>
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="Edit" method="post" class="form-4col">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TravelerId" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="CustomerId">Customer</label>
                <div class="form-4col-field">
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers"></select>
                </div>
                <label class="form-4col-label" asp-for="FullName">Full Name</label>
                <div class="form-4col-field">
                    <input asp-for="FullName" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="FatherName">Father Name</label>
                <div class="form-4col-field">
                    <input asp-for="FatherName" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="Gender">Gender</label>
                <div class="form-4col-field">
                    <input asp-for="Gender" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="DateOfBirth">Date of Birth</label>
                <div class="form-4col-field">
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="NationalityCountryId">Nationality</label>
                <div class="form-4col-field">
                    <select asp-for="NationalityCountryId" class="form-select" asp-items="ViewBag.Countries">
                        <option value="">--</option>
                    </select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="Cnic">CNIC</label>
                <div class="form-4col-field">
                    <input asp-for="Cnic" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="MobileNo">Mobile</label>
                <div class="form-4col-field">
                    <input asp-for="MobileNo" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="PassportNo">Passport No</label>
                <div class="form-4col-field">
                    <input asp-for="PassportNo" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="PassportIssueDate">Issue Date</label>
                <div class="form-4col-field">
                    <input asp-for="PassportIssueDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="PassportExpiryDate">Expiry Date</label>
                <div class="form-4col-field">
                    <input asp-for="PassportExpiryDate" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="Relationship">Relationship</label>
                <div class="form-4col-field">
                    <input asp-for="Relationship" class="form-control" />
                </div>
            </div>

            <div class="form-4col-actions">
                <button class="btn btn-primary" type="submit">Update</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>