@model IEnumerable<TourismHajj.Models.Entities.GalleryItem>
@{
    ViewData["Title"] = "Gallery";
}
@await Html.PartialAsync("_AlertMessages")
<div class="page-header d-flex justify-content-between align-items-center">
    <h2>Gallery</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1"></i> Add Image</a>
</div>
<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Sort</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="@item.ImageUrl" alt="@item.Title" style="width:72px;height:48px;object-fit:cover;border-radius:6px;" /></td>
                    <td>@item.Title</td>
                    <td>@item.SortOrder</td>
                    <td>@(item.IsActive ? "Active" : "Inactive")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.GalleryItemId"><i class="fa-solid fa-pen"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.GalleryItemId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Deactivate this gallery image?"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-muted text-center">No gallery images yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
