@model CustomerPortalDashboardViewModel
@{ Layout = "_CustomerLayout"; }
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card-panel p-3"><div class="text-muted small">Total Bookings</div><div class="fs-3 fw-bold">@Model.TotalBookings</div></div></div>
    <div class="col-md-3"><div class="card-panel p-3"><div class="text-muted small">Upcoming Trips</div><div class="fs-3 fw-bold">@Model.UpcomingTrips</div></div></div>
    <div class="col-md-3"><div class="card-panel p-3"><div class="text-muted small">Pending Payments</div><div class="fs-3 fw-bold">@Model.PendingPayments</div></div></div>
    <div class="col-md-3"><div class="card-panel p-3"><div class="text-muted small">Completed Trips</div><div class="fs-3 fw-bold">@Model.CompletedTrips</div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card-panel p-3">
            <h5>Recent Bookings</h5>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Booking</th><th>Package</th><th>Status</th><th>Balance</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        <tr>
                            <td><a asp-action="BookingDetails" asp-route-id="@b.BookingId">@b.BookingNo</a></td>
                            <td>@b.Package?.PackageName</td>
                            <td>@b.BookingStatus</td>
                            <td>@((b.BalanceAmount ?? 0).ToString("N2"))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-panel p-3 mb-4">
            <h5>Upcoming Departures</h5>
            @foreach (var d in Model.UpcomingDepartures)
            {
                <div class="border-bottom py-2">@d.DepartureDate.ToString("dd MMM yyyy") · Package #@d.PackageId</div>
            }
            @if (!Model.UpcomingDepartures.Any()) { <div class="text-muted">No upcoming departures.</div> }
        </div>
        <div class="card-panel p-3">
            <h5>Payment History</h5>
            @foreach (var p in Model.RecentPayments)
            {
                <div class="border-bottom py-2 d-flex justify-content-between">
                    <span>@p.PaymentDate?.ToString("dd MMM yyyy")</span>
                    <strong>@p.Amount.ToString("N2")</strong>
                </div>
            }
            @if (!Model.RecentPayments.Any()) { <div class="text-muted">No payments yet.</div> }
        </div>
    </div>
</div>
