@model RefundListViewModel
@{ ViewData["Title"] = "Refunds"; }
@await Html.PartialAsync("_Alerts")
<div class="page-header">
    <div><h2>Refunds</h2></div>
    <a class="btn btn-sm btn-accent" asp-action="Create"><i class="fa-solid fa-plus"></i> Add</a>
</div>
<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Booking</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Refunds)
            {
                <tr>
                    <td>@item.RefundDate?.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Booking?.BookingNo</td>
                    <td>@item.RefundAmount.ToString("N2")</td>
                    <td>@item.RefundStatus</td>
                    <td>@item.RefundReason</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
