@model RefundInputModel
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="@(Model.RefundId > 0 ? "Edit" : "Create")" method="post" class="form-4col">
            <input type="hidden" asp-for="RefundId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="BookingId">Booking</label>
                <div class="form-4col-field">
                    <select asp-for="BookingId" class="form-select" asp-items="@(new SelectList(Model.BookingOptions, nameof(Booking.BookingId), nameof(Booking.BookingNo)))"></select>
                </div>
                <label class="form-4col-label" asp-for="PaymentId">Payment</label>
                <div class="form-4col-field">
                    <select asp-for="PaymentId" class="form-select" asp-items="@(new SelectList(Model.PaymentOptions, nameof(Payment.PaymentId), nameof(Payment.ReferenceNo)))">
                        <option value="">— Optional —</option>
                    </select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="RefundDate">Refund Date</label>
                <div class="form-4col-field">
                    <input asp-for="RefundDate" type="date" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="RefundAmount">Refund Amount</label>
                <div class="form-4col-field">
                    <input asp-for="RefundAmount" class="form-control" />
                    <span asp-validation-for="RefundAmount" class="text-danger"></span>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="RefundStatus">Refund Status</label>
                <div class="form-4col-field">
                    <input asp-for="RefundStatus" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="PaymentMethod">Payment Method</label>
                <div class="form-4col-field">
                    <input asp-for="PaymentMethod" class="form-control" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="RefundReason">Refund Reason</label>
                <div class="form-4col-field">
                    <textarea asp-for="RefundReason" class="form-control" rows="2"></textarea>
                </div>
                <span></span>
                <span></span>
            </div>

            <div class="form-4col-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>