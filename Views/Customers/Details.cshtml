@model TourismHajj.ViewModels.CustomerDetailsViewModel
@{ ViewData["Title"] = "Customer Details"; var c = Model.Customer; }
@await Html.PartialAsync("_Alerts")
<div class="page-header">
<div><h2>@c.CustomerName</h2><p class="text-muted mb-0">Tracking: <strong>@(c.TrackingNo ?? "—")</strong> · @(c.GroupType ?? "No group") · @c.CustomerType · @c.MobileNo</p></div>
<div><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@c.CustomerId">Edit Customer &amp; Group</a>
<a class="btn btn-sm btn-accent" asp-controller="Travelers" asp-action="Create" asp-route-customerId="@c.CustomerId">Add Traveler</a></div>
</div>
<div class="row g-3">
<div class="col-lg-4"><div class="card-panel"><div class="card-panel-header"><h5>Personal Information</h5></div><div class="card-panel-body">
<dl class="row mb-0">
<dt class="col-5">Tracking No</dt><dd class="col-7"><strong>@(c.TrackingNo ?? "—")</strong></dd>
<dt class="col-5">Group Type</dt><dd class="col-7">@(c.GroupType ?? "—")</dd>
<dt class="col-5">Father</dt><dd class="col-7">@c.FatherName</dd>
<dt class="col-5">WhatsApp</dt><dd class="col-7">@c.WhatsAppNo</dd>
<dt class="col-5">Email</dt><dd class="col-7">@c.Email</dd>
<dt class="col-5">CNIC</dt><dd class="col-7">@c.Cnic</dd>
<dt class="col-5">City</dt><dd class="col-7">@(c.City?.CityName)</dd>
<dt class="col-5">Address</dt><dd class="col-7">@c.Address</dd>
<dt class="col-5">Outstanding</dt><dd class="col-7 fw-bold text-danger">@Model.TotalOutstanding.ToString("N2")</dd>
</dl></div></div></div>
<div class="col-lg-8">
<div class="card-panel mb-3"><div class="card-panel-header"><h5>Group Members</h5></div>
<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Name</th><th>Relationship</th><th>Passport</th><th>Mobile</th></tr></thead>
<tbody>@foreach (var t in Model.Travelers){<tr><td><a asp-controller="Travelers" asp-action="Details" asp-route-id="@t.TravelerId">@t.FullName</a></td><td>@(t.Relationship ?? "—")</td><td>@(t.PassportNo ?? "—")</td><td>@(t.MobileNo ?? "—")</td></tr>}
@if(!Model.Travelers.Any()){<tr><td colspan="4" class="text-muted text-center">No group members</td></tr>}</tbody></table></div></div>
<div class="card-panel mb-3"><div class="card-panel-header"><h5>Booking History</h5></div>
<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Booking</th><th>Package</th><th>Net</th><th>Balance</th><th>Status</th></tr></thead>
<tbody>@foreach (var b in Model.Bookings){<tr><td><a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.BookingId">@b.BookingNo</a></td><td>@b.PackageName</td><td>@((b.NetAmount??0).ToString("N2"))</td><td>@((b.BalanceAmount??0).ToString("N2"))</td><td>@b.BookingStatus</td></tr>}
@if(!Model.Bookings.Any()){<tr><td colspan="5" class="text-muted text-center">No bookings</td></tr>}</tbody></table></div></div>
<div class="card-panel"><div class="card-panel-header"><h5>Payment History</h5></div>
<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Ref</th></tr></thead>
<tbody>@foreach (var p in Model.Payments){<tr><td>@p.PaymentDate?.ToString("dd-MMM-yyyy")</td><td>@p.Amount.ToString("N2")</td><td>@p.PaymentMethod</td><td>@p.BookingNo</td></tr>}
@if(!Model.Payments.Any()){<tr><td colspan="4" class="text-muted text-center">No payments</td></tr>}</tbody></table></div></div>
</div></div>
