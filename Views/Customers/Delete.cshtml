@model Customer
@{
    ViewData["Title"] = "Delete Customer";
}
<h1 class="h3 mb-4 text-danger">Delete Customer</h1>
<div class="alert alert-warning">Customers with bookings will be deactivated instead of deleted.</div>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.CustomerName</dd>
    <dt class="col-sm-3">Mobile</dt><dd class="col-sm-9">@Model.MobileNo</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CustomerId" />
    <button type="submit" class="btn btn-danger">Confirm</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>