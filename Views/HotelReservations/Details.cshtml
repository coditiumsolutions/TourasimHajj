@model TourismHajj.Models.Entities.HotelReservation
@{
    ViewData["Title"] = "Reservation details";
}
<div class="mb-3">
    <a asp-action="Index" class="btn btn-link px-0">&larr; All reservations</a>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-3">@Model.HotelName</h1>
        <dl class="row mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">@Model.HotelReservationId</dd>
            <dt class="col-sm-3">Supplier ref</dt>
            <dd class="col-sm-9">@(Model.SupplierBookingReference ?? "—")</dd>
            <dt class="col-sm-3">Client ref</dt>
            <dd class="col-sm-9">@(Model.ClientReference ?? "—")</dd>
            <dt class="col-sm-3">Provider</dt>
            <dd class="col-sm-9">@Model.Provider</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Destination</dt>
            <dd class="col-sm-9">@Model.Destination</dd>
            <dt class="col-sm-3">Stay</dt>
            <dd class="col-sm-9">@Model.CheckIn.ToString("dd MMM yyyy") – @Model.CheckOut.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Room</dt>
            <dd class="col-sm-9">@(Model.RoomName ?? "—") @(Model.BoardName)</dd>
            <dt class="col-sm-3">Occupancy</dt>
            <dd class="col-sm-9">@Model.Rooms room(s), @Model.Adults adult(s), @Model.Children child(ren)</dd>
            <dt class="col-sm-3">Net / Sell</dt>
            <dd class="col-sm-9">@(Model.NetAmount?.ToString("0.##") ?? "—") / @(Model.SellingAmount?.ToString("0.##") ?? "—") @Model.Currency</dd>
            <dt class="col-sm-3">Holder</dt>
            <dd class="col-sm-9">@Model.HolderFirstName @Model.HolderLastName<br />@Model.HolderEmail<br />@Model.HolderPhone</dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime()</dd>
        </dl>
    </div>
</div>
