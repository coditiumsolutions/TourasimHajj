@model TransportProviderListViewModel
@{ ViewData["Title"] = "Transport Providers"; }
@await Html.PartialAsync("_Alerts")
<div class="page-header">
    <div><h2>Transport Providers</h2></div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive" @(Model.IncludeInactive ? "checked" : null) onchange="this.form.submit()" />
                <label class="form-check-label" for="includeInactive">Include inactive</label>
            </div>
        </form>
        <a class="btn btn-sm btn-accent" asp-action="Create"><i class="fa-solid fa-plus"></i> Add</a>
    </div>
</div>
<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Vehicle</th>
                    <th>Capacity</th>
                    <th>Contact</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Providers)
            {
                <tr>
                    <td>@item.ProviderName</td>
                    <td>@item.VehicleType</td>
                    <td>@item.VehicleCapacity</td>
                    <td>@item.ContactNo</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.TransportProviderId"><i class="fa-solid fa-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.TransportProviderId"><i class="fa-solid fa-pen"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
