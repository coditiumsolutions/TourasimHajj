@model TransportProviderInputModel
<div class="card-panel">
    <div class="card-panel-body">
        <form asp-action="@(Model.TransportProviderId > 0 ? "Edit" : "Create")" method="post" class="form-4col">
            <input type="hidden" asp-for="TransportProviderId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="ProviderName">Provider Name</label>
                <div class="form-4col-field">
                    <input asp-for="ProviderName" class="form-control" />
                    <span asp-validation-for="ProviderName" class="text-danger"></span>
                </div>
                <label class="form-4col-label" asp-for="SupplierId">Supplier</label>
                <div class="form-4col-field">
                    <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.SupplierOptions, nameof(Supplier.SupplierId), nameof(Supplier.SupplierName)))">
                        <option value="">— Optional —</option>
                    </select>
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="VehicleType">Vehicle Type</label>
                <div class="form-4col-field">
                    <input asp-for="VehicleType" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="VehicleCapacity">Capacity</label>
                <div class="form-4col-field">
                    <input asp-for="VehicleCapacity" class="form-control" type="number" />
                </div>
            </div>

            <div class="form-4col-row">
                <label class="form-4col-label" asp-for="ContactNo">Contact No</label>
                <div class="form-4col-field">
                    <input asp-for="ContactNo" class="form-control" />
                </div>
                <label class="form-4col-label" asp-for="IsActive">Active</label>
                <div class="form-4col-field form-4col-check">
                    <input asp-for="IsActive" class="form-check-input" />
                </div>
            </div>

            <div class="form-4col-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>