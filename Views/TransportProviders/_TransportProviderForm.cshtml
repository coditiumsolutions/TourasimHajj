@model TransportProviderInputModel
<form asp-action="@(Model.TransportProviderId > 0 ? "Edit" : "Create")" method="post" class="card-panel p-4">
    <input type="hidden" asp-for="TransportProviderId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="ProviderName" class="form-label"></label>
            <input asp-for="ProviderName" class="form-control" />
            <span asp-validation-for="ProviderName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.SupplierOptions, nameof(Supplier.SupplierId), nameof(Supplier.SupplierName)))">
                <option value="">— Optional —</option>
            </select>
        </div>
        <div class="col-md-4"><label asp-for="VehicleType" class="form-label"></label><input asp-for="VehicleType" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="VehicleCapacity" class="form-label"></label><input asp-for="VehicleCapacity" class="form-control" type="number" /></div>
        <div class="col-md-4"><label asp-for="ContactNo" class="form-label"></label><input asp-for="ContactNo" class="form-control" /></div>
        <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>