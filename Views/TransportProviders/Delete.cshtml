@model TransportProvider
@{
    ViewData["Title"] = "Delete Transport Provider";
}
<div class="page-header"><h1 class="h3 text-danger mb-0">Deactivate Provider</h1></div>
<div class="card-panel p-4">
    <p>Deactivate transport provider <strong>@Model.ProviderName</strong>?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="TransportProviderId" />
        <button type="submit" class="btn btn-danger" data-confirm="Deactivate this transport provider?">Confirm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>