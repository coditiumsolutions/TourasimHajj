@model SupplierPaymentListViewModel
@{ ViewData["Title"] = "Supplier Payments"; }
@await Html.PartialAsync("_Alerts")
<div class="page-header">
    <div><h2>Supplier Payments</h2></div>
    <a class="btn btn-sm btn-accent" asp-action="Create"><i class="fa-solid fa-plus"></i> Add</a>
</div>
<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Ref</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Payments)
            {
                <tr>
                    <td>@item.PaymentDate.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Supplier?.SupplierName</td>
                    <td>@item.Amount.ToString("N2")</td>
                    <td>@item.PaymentMethod</td>
                    <td>@item.ReferenceNo</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
