@model CustomerLoginViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Customer Login";
}
<section class="auth-shell">
    <div class="auth-card">
        <div class="text-center mb-3">
            <span class="brand-mark">TH</span>
            <h1 class="h4 mt-2 mb-1">Customer Login</h1>
            <p class="text-muted small mb-0">Access your bookings, travelers and payments</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="EmailOrMobile" class="form-label"></label>
                <input asp-for="EmailOrMobile" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button class="btn-gold w-100 border-0" type="submit">Login</button>
        </form>
        <div class="d-flex justify-content-between mt-3 small">
            <a asp-action="Register">Register New Account</a>
            <a href="#">Forgot Password</a>
        </div>
        <div class="text-center mt-3 small">
            <a asp-controller="Account" asp-action="Login">Admin Login</a>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
