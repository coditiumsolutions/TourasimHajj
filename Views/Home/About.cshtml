@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "About Us";
}
<section class="hajj-component packages-theme-all about-hero-component">
    <div class="hajj-component-media" aria-hidden="true">
        <img src="/images/about01.jpg?v=1" alt="" />
    </div>
    <div class="hajj-component-shade" aria-hidden="true"></div>
    <div class="container-xl hajj-component-inner">
        <div class="hajj-component-copy">
            <h1 class="packages-hero-title">About Us</h1>
