@model PublicHomeViewModel
@using Microsoft.Extensions.Options
@using TourismHajj.Helpers
@inject IOptions<CompanyProfileOptions> CompanyOptions
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Home";
    var company = CompanyOptions.Value;
}

<section class="hero-swiper swiper">
    <div class="swiper-wrapper">
        <div class="swiper-slide hero-slide" style="background-image:url('https://images.unsplash.com/photo-1591604129939-f1efa4d9f7fa?auto=format&fit=crop&w=1920&q=80');">
            <div class="container-xl">
                <div class="hero-content">
                    <h1>Your Spiritual Journey Begins Here</h1>
                    <p>Experience a comfortable and well-organized Hajj journey at Masjid al-Haram.</p>
                    <a class="btn-gold" asp-controller="Home" asp-action="Search" asp-route-PackageType="Hajj">Explore Hajj Packages</a>
                </div>
            </div>
        </div>
        <div class="swiper-slide hero-slide" style="background-image:url('https://images.unsplash.com/photo-1542816417-0983c9c9ad53?auto=format&fit=crop&w=1920&q=80');">
            <div class="container-xl">
                <div class="hero-content">
                    <h1>Visit Masjid an-Nabawi</h1>
                    <p>Peaceful Madinah journeys with trusted Umrah and pilgrimage arrangements.</p>
                    <a class="btn-gold" asp-controller="Home" asp-action="Search" asp-route-PackageType="Umrah">Explore Umrah Packages</a>
                </div>
            </div>
        </div>
        <div class="swiper-slide hero-slide" style="background-image:url('/images/valley.jpeg');">
            <div class="container-xl">
                <div class="hero-content">
                    <h1>Explore The World With Us</h1>
                    <p>Discover amazing destinations and unforgettable travel experiences.</p>
                    <a class="btn-gold" asp-controller="Home" asp-action="Search" asp-route-PackageType="International">Explore Packages</a>
                </div>
            </div>
        </div>
        <div class="swiper-slide hero-slide" style="background-image:url('/images/kabba01.jpg?v=2');">
            <div class="container-xl">
                <div class="hero-content">
                    <h1>Blessed Moments at the Kaaba</h1>
                    <p>Another view of Khana Kaaba for your sacred pilgrimage journey.</p>
                    <a class="btn-gold" asp-controller="Home" asp-action="Search" asp-route-PackageType="Hajj">Explore Hajj Packages</a>
                </div>
            </div>
        </div>
    </div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-pagination"></div>
</section>

<section class="container-xl">
    <div class="search-panel">
        <form asp-controller="Home" asp-action="Search" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Package Type</label>
                <select class="form-select" name="PackageType" asp-for="Search.PackageType">
                    <option value="All">All</option>
                    <option value="Domestic">Domestic</option>
                    <option value="International">International</option>
                    <option value="Hajj">Hajj</option>
                    <option value="Umrah">Umrah</option>
                    <option value="Ziarat">Ziarat</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Destination</label>
                <select class="form-select" name="DestinationId" asp-for="Search.DestinationId">
                    <option value="">Any destination</option>
                    @foreach (var d in Model.Search.DestinationOptions)
                    {
                        <option value="@d.DestinationId">@d.DestinationName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Departure Date</label>
                <input class="form-control" type="date" name="DepartureDate" value="@Model.Search.DepartureDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Travelers</label>
                <input class="form-control" type="number" min="1" name="Travelers" value="@(Model.Search.Travelers > 0 ? Model.Search.Travelers : 1)" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-navy w-100" type="submit"><i class="fa-solid fa-magnifying-glass me-1"></i> Search</button>
            </div>
        </form>
    </div>
</section>

<section class="section-pad" id="destinations">
    <div class="container-xl">
        <h2 class="section-title">Popular Destinations</h2>
        <p class="section-sub">Explore destinations loaded from our travel database.</p>
        <div class="row g-4">
            @foreach (var d in Model.Destinations)
            {
                <div class="col-md-6 col-lg-3">
                    <article class="dest-card">
                        <img src="@d.ImageUrl" alt="@d.DestinationName" loading="lazy" />
                        <div class="body">
                            <h5 class="mb-1">@d.DestinationName</h5>
                            <small class="text-muted">@(d.CityName ?? "Featured destination")</small>
                        </div>
                    </article>
                </div>
            }
            @if (!Model.Destinations.Any())
            {
                <div class="col-12"><div class="alert alert-light border">Destinations will appear here once configured in the admin panel.</div></div>
            }
        </div>
    </div>
</section>

<section class="section-pad">
    <div class="container-xl">
        <h2 class="section-title">Why Choose Us</h2>
        <p class="section-sub">A professional travel partner for leisure and pilgrimage.</p>
        <div class="row g-4">
            @{
                var features = new (string Icon, string Title, string Text)[]
                {
                    ("fa-user-tie", "Experienced Travel Team", "Seasoned consultants for tourism and pilgrimage planning."),
                    ("fa-hotel", "Comfortable Accommodation", "Carefully selected hotels near key destinations."),
                    ("fa-bus", "Reliable Transportation", "Trusted transport partners for every journey."),
                    ("fa-headset", "Professional Customer Support", "Helpful assistance before, during and after travel."),
                    ("fa-scale-balanced", "Transparent Pricing", "Clear package rates with no hidden surprises."),
                    ("fa-suitcase-rolling", "Complete Travel Assistance", "End-to-end support from booking to departure.")
                };
            }
            @foreach (var f in features)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="feature-card">
                        <div class="icon"><i class="fa-solid @f.Icon"></i></div>
                        <h5>@f.Title</h5>
                        <p class="mb-0 text-muted">@f.Text</p>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

<section class="section-pad">
    <div class="container-xl">
        <h2 class="section-title">Customer Testimonials</h2>
        <p class="section-sub">Demo testimonials shown until real customer reviews are collected.</p>
        <div class="swiper testimonial-swiper">
            <div class="swiper-wrapper">
                @foreach (var t in new[] {
                    ("Ayesha K.", "Umrah Package", "Everything was organized beautifully — hotels, transport and guidance."),
                    ("Usman R.", "Northern Pakistan Tour", "A smooth booking experience and an unforgettable trip to Hunza."),
                    ("Fatima S.", "Hajj Package", "Professional team and transparent communication throughout.")
                })
                {
                    <div class="swiper-slide">
                        <article class="testimonial-card">
                            <span class="demo-badge">Demo content</span>
                            <p class="quote">“@t.Item3”</p>
                            <strong>@t.Item1</strong>
                            <div class="text-muted small">@t.Item2</div>
                        </article>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="section-pad" id="contact">
    <div class="container-xl">
        <div class="row g-4">
            <div class="col-lg-5">
                <h2 class="section-title">Contact Us</h2>
                <p class="section-sub">Reach our team for package guidance and booking support.</p>
                <ul class="list-unstyled mb-4">
                    <li class="mb-2"><i class="fa-solid fa-location-dot me-2 text-warning"></i>@company.Address</li>
                    <li class="mb-2"><i class="fa-solid fa-phone me-2 text-warning"></i>@company.Phone</li>
                    <li class="mb-2"><i class="fa-brands fa-whatsapp me-2 text-warning"></i>@company.WhatsApp</li>
                    <li class="mb-2"><i class="fa-solid fa-envelope me-2 text-warning"></i>@company.Email</li>
                </ul>
                <iframe class="map-frame" src="@company.MapEmbedUrl" loading="lazy" title="Company location map"></iframe>
            </div>
            <div class="col-lg-7">
                <div class="contact-panel">
                    <form asp-controller="Contact" asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <input class="form-control" name="FullName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input class="form-control" type="email" name="Email" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input class="form-control" name="Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subject</label>
                                <input class="form-control" name="Subject" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" name="Message" rows="5" required></textarea>
                            </div>
                            <div class="col-12">
                                <button class="btn-gold" type="submit">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
