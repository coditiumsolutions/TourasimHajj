@model List<PublicPackageCardViewModel>
<div class="row g-4 packages-grid">
@if (Model == null || Model.Count == 0)
{
    <div class="col-12">
        <div class="packages-empty">
            <i class="fa-solid fa-suitcase-rolling"></i>
            <h3>No packages found</h3>
            <p>Try another package type or clear the filters to see more options.</p>
        </div>
    </div>
}
else
{
    foreach (var p in Model)
    {
        var typeSlug = (p.PackageType ?? "").Trim().ToLowerInvariant();
        var currency = p.CurrencyCode ?? "PKR";
        <div class="col-sm-6 col-xl-4">
            <article class="package-card package-card-rich type-@typeSlug">
                <div class="package-card-media">
                    <img src="@p.CoverImageUrl" alt="@p.PackageName" loading="lazy" />
                    <span class="badge-type badge-type-@typeSlug">@p.PackageType</span>
                    @if (p.NextDepartureDate.HasValue)
                    {
                        <span class="package-depart-chip">
                            <i class="fa-regular fa-calendar"></i>
                            @p.NextDepartureDate.Value.ToString("dd MMM yyyy")
                        </span>
                    }
                </div>
                <div class="body">
                    <h5>@p.PackageName</h5>
                    <table class="package-detail-table">
                        <tbody>
                            <tr>
                                <th>Name</th>
                                <td>@p.PackageName</td>
                                <th>Type</th>
                                <td>@p.PackageType</td>
                            </tr>
                            <tr>
                                <th>Days</th>
                                <td>@(p.DurationDays?.ToString() ?? "—")</td>
                                <th>Nights</th>
                                <td>@(p.DurationNights?.ToString() ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td colspan="3">@(string.IsNullOrWhiteSpace(p.Description) ? "—" : p.Description)</td>
                            </tr>
                            <tr>
                                <th>Adult</th>
                                <td>@((p.AdultPrice ?? 0).ToString("N2"))</td>
                                <th>Child</th>
                                <td>@((p.ChildPrice ?? 0).ToString("N2"))</td>
                            </tr>
                            <tr>
                                <th>Infant</th>
                                <td>@((p.InfantPrice ?? 0).ToString("N2"))</td>
                                <th>Currency</th>
                                <td>@currency</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="package-card-footer">
                        <div>
                            <div class="price-label">Adult from</div>
                            <div class="price">@currency @((p.AdultPrice ?? 0).ToString("N0"))</div>
                        </div>
                        <a class="btn btn-package-cta" asp-controller="Packages" asp-action="Details" asp-route-id="@p.PackageId">
                            View Details <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </article>
        </div>
    }
}
</div>
