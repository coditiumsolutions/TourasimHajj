@model SupplierInputModel
<form asp-action="@(Model.SupplierId > 0 ? "Edit" : "Create")" method="post" class="card-panel p-4">
    <input type="hidden" asp-for="SupplierId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SupplierName" class="form-label"></label>
            <input asp-for="SupplierName" class="form-control" />
            <span asp-validation-for="SupplierName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SupplierType" class="form-label"></label>
            <input asp-for="SupplierType" class="form-control" list="supplierTypes" />
            <datalist id="supplierTypes">
                <option value="General" /><option value="Hotel" /><option value="Transport" /><option value="Visa" /><option value="Airline" />
            </datalist>
        </div>
        <div class="col-md-4"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="MobileNo" class="form-label"></label><input asp-for="MobileNo" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
        <div class="col-md-6">
            <label asp-for="CountryId" class="form-label"></label>
            <select asp-for="CountryId" class="form-select" asp-items="@(new SelectList(Model.CountryOptions, nameof(Country.CountryId), nameof(Country.CountryName)))">
                <option value="">— Select —</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="CityId" class="form-label"></label>
            <select asp-for="CityId" class="form-select" asp-items="@(new SelectList(Model.CityOptions, nameof(City.CityId), nameof(City.CityName)))">
                <option value="">— Select —</option>
            </select>
        </div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div>
        <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>